          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="note" value="Our component separates the work: the controller receives requests, the service checks the rules, and the repository reads or updates field definitions. This follows separation of concerns because each part has its own job. It has high cohesion because its features focus on managing and providing form guidance. It uses low coupling by connecting the parts through defined interfaces, so changing how field definitions are stored requires fewer changes elsewhere." style="text;html=0;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=16;" parent="1" vertex="1">
          <mxGeometry x="40" y="400" width="880" height="65" as="geometry" />
        </mxCell>
